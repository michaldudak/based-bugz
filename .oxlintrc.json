{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"env": {
		"browser": true,
		"es2024": true
	},
	"plugins": ["react", "typescript", "jsx-a11y", "import", "unicorn"],
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"settings": {
		"react": {
			"runtime": "automatic"
		}
	},
	"rules": {
		"react-hooks/exhaustive-deps": "error",
		"react-hooks/rules-of-hooks": "error",
		"eqeqeq": [
			"error",
			"always",
			{
				"null": "ignore"
			}
		],
		"no-console": [
			"warn",
			{
				"allow": ["warn", "error"]
			}
		],
		"unicorn/prefer-node-protocol": "error",
		"react/react-in-jsx-scope": "off",
		"import/no-unassigned-import": [
			"error",
			{
				"allow": ["**/*.css"]
			}
		]
	},
	"ignorePatterns": ["dist/**", "node_modules/**", "playwright-report/**", "test-results/**"],
	"overrides": [
		{
			"files": ["src/ds/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@/features",
									"@/features/**",
									"@/data",
									"@/data/**",
									"@/impls",
									"@/impls/**",
									"@/app",
									"@/app/**",
									"**/features/**",
									"**/data/**",
									"**/impls/**",
									"**/app/**"
								],
								"message": "ds/ is app-agnostic: no domain, data, app or impl imports (AGENTS.md \u2014 Import rules)"
							}
						],
						"paths": [
							{
								"name": "react",
								"importNames": ["useDeferredValue", "startTransition"],
								"message": "Evaluation rule 6: no deferred rendering in the filter path \u2014 it papers over a slow list"
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/data/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@/ds",
									"@/ds/**",
									"@/features",
									"@/features/**",
									"@/impls",
									"@/impls/**",
									"@/app",
									"@/app/**",
									"**/ds/**",
									"**/features/**",
									"**/impls/**",
									"**/app/**"
								],
								"message": "data/ is the bottom layer: it imports nothing from the UI (AGENTS.md \u2014 Import rules)"
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/features/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@/impls", "@/impls/**", "**/impls/**"],
								"message": "features/ reaches virtualization only through ds/combobox (AGENTS.md \u2014 Import rules)"
							}
						],
						"paths": [
							{
								"name": "react",
								"importNames": ["useDeferredValue", "startTransition"],
								"message": "Evaluation rule 6: no deferred rendering in the filter path \u2014 it papers over a slow list"
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/impls/baseline/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@/features",
									"@/features/**",
									"@/data",
									"@/data/**",
									"@/app",
									"@/app/**",
									"@/impls/**",
									"../**"
								],
								"message": "impls/ are generic over T: no domain, data or sibling-impl imports; use @/ds/* aliases (AGENTS.md \u2014 Import rules)"
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/impls/pr-*/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@base-ui/react", "@base-ui/react/**"],
								"message": "Canary impls must import their own aliased build (base-ui-a|b|c), never stable @base-ui/react \u2014 importing stable here silently benchmarks the wrong package"
							},
							{
								"group": [
									"@/features",
									"@/features/**",
									"@/data",
									"@/data/**",
									"@/app",
									"@/app/**",
									"@/impls/**",
									"../**"
								],
								"message": "impls/ are generic over T: no domain, data or sibling-impl imports; use @/ds/* aliases (AGENTS.md \u2014 Import rules)"
							}
						]
					}
				]
			}
		},
		{
			"files": ["scripts/**"],
			"rules": {
				"no-console": "off"
			}
		}
	]
}
